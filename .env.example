# Copy to .env.local (or run `vercel env pull .env.local --yes`) and fill in.
# Only NEXT_PUBLIC_* values and the Nexconn App Key ever reach the browser.

# Neon Postgres: pooled connection for the app, direct connection for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (sign-in, sign-up, sessions). The secret key is also used by the e2e tests
# to request testing tokens and by `npm run e2e:cleanup` to delete test accounts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Nexconn (Singapore data center). After changing the App Key, run `npm run nexconn:provision`.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE=https://api.sg-light-api.com
# Prefix for every Nexconn user and group id this app creates (1-12 letters or digits)
NEXCONN_ID_PREFIX=agv

# Gemini (agents). The fallback model is used when the main one is busy or rate limited.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Vercel Blob (profile photos and agent avatars)
BLOB_READ_WRITE_TOKEN=

# Optional: canonical URL for metadata, Open Graph, robots.txt and the sitemap
NEXT_PUBLIC_SITE_URL=
