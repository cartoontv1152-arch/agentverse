# Copy to .env.local (or run `vercel env pull .env.local --yes`) and fill in.
# Server-only values never reach the browser except NEXT_PUBLIC_* and the Nexconn App Key.

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Clerk (sign-in, sign-up, sessions)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Nexconn (Singapore data center)
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_ID_PREFIX=agv

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Vercel Blob (avatars)
BLOB_READ_WRITE_TOKEN=

# Optional: canonical URL for metadata and sitemaps
NEXT_PUBLIC_SITE_URL=
