{
  "name": "agentverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3102",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mts",
    "check": "npm run typecheck && npm run lint && npm test",
    "nexconn:provision": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/provision-nexconn.mts",
    "e2e:cleanup": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/cleanup-e2e.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.5",
    "@google/genai": "^3.6.0",
    "@neondatabase/serverless": "^1.2.1",
    "@nexconn/chat": "26.2.1",
    "@nexconn/engine": "26.2.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
